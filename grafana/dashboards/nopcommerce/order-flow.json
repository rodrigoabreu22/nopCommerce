        "y": 4,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "expr": "(sum(increase(checkout_place_order_duration_ms_sum[$__range])) / clamp_min(sum(increase(checkout_place_order_duration_ms_count[$__range])), 1))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
