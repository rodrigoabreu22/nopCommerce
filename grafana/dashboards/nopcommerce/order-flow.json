{
  "id": null,
  "uid": "nop-order-flow",
  "title": "nopCommerce - Order Flow",
  "tags": ["nopcommerce", "order", "flow"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "text",
      "title": "Order Flow - Overview",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "This dashboard tracks the **Customer places an order** flow. Current panels cover payment outcomes and order persistence latency. They are intended to separate payment-path issues from order-save degradation."
      }
    },
    {
      "type": "timeseries",
      "title": "Checkout Payment Result Rate",
      "id": 2,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (result) (rate(checkout_payment_result_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout Order Save p95 Duration (ms)",
      "id": 3,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(checkout_order_save_duration_ms_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout Payment Result Rate by Method",
      "id": 4,
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum by (payment_method, result) (rate(checkout_payment_result_total[5m]))",
          "legendFormat": "{{payment_method}} / {{result}}",
          "refId": "A"
        }
      ]
    }
  ]
}
