    {
      "type": "stat",
      "title": "Checkout Entry Errors",
      "description": "Exceptions caught at the OpcConfirmOrder entry point (empty cart, session expired, payment info missing). These fire BEFORE PlaceOrderAsync \u2014 a spike here without a matching spike in Failure Count points to a client/session problem, not a payment issue.",
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(sum(increase(checkout_opc_confirm_errors_total[$__range])) or vector(0))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Checkout Error Rate (events/s)",
      "description": "Two failure signals in the same unit (events per second).\nservice-layer failures/s: exceptions inside PlaceOrderAsync \u2014 payment, database, or inventory problems.\nentry-point errors/s: rejections before PlaceOrderAsync is reached \u2014 session, CSRF, or missing payment step.\nBoth rising together suggests infrastructure. Only entry-point rising suggests a client/session problem.",
      "id": 10,
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(checkout_place_order_failures_total[$__rate_interval])) or vector(0)",
          "legendFormat": "service-layer failures/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(checkout_opc_confirm_errors_total[$__rate_interval])) or vector(0)",
          "legendFormat": "entry-point errors/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Checkout Payment Result Rate",
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(checkout_payment_result_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout Failure Rate by Stage",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (stage) (rate(checkout_place_order_failures_total[$__rate_interval]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout Payment Result Rate by Method",
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (payment_method, result) (rate(checkout_payment_result_total[$__rate_interval]))",
          "legendFormat": "{{payment_method}} / {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Place Order vs Order Save Duration (ms)",
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(checkout_place_order_duration_ms_sum[$__rate_interval])) / clamp_min(sum(rate(checkout_place_order_duration_ms_count[$__rate_interval])), 1))",
          "legendFormat": "place_order_avg",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(checkout_order_save_duration_ms_sum[$__rate_interval])) / clamp_min(sum(rate(checkout_order_save_duration_ms_count[$__rate_interval])), 1))",
          "legendFormat": "order_save_avg",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Total Checkout Attempts",
      "description": "All OpcConfirmOrder calls in the selected time window: successful orders + service-layer failures + entry-point rejections. Use this to establish baseline traffic \u2014 a sudden drop here means the entire checkout pipeline stopped, regardless of whether it was a payment or database problem.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "datasource": null,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "super-light-blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "super-light-blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": null,
          "expr": "sum(increase(checkout_payment_result_total[$__range])) or vector(0)",
          "legendFormat": "payment_results",
          "refId": "A"
        },
        {
          "datasource": null,
          "expr": "sum(increase(checkout_opc_confirm_errors_total[$__range])) or vector(0)",
          "legendFormat": "entry_errors",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "sum"
            ],
            "mode": "reduceFields",
            "includeTimeField": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "Total Attempts"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Total Attempts"
              ]
            }
          }
        }
      ]
    }
  ]
